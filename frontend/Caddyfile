# Railway web server: serves the built app and forwards API, live progress and generated files to the
# backend on the Mac (through the tunnel URL in BACKEND_URL). The backend checks the login on every request.
{
	admin off
}

:{$PORT:8080} {
	encode gzip

	@backend path /api/* /ws/* /outputs/*
	handle @backend {
		reverse_proxy {$BACKEND_URL} {
			header_up Host {upstream_hostport}
			flush_interval -1
		}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		X-Frame-Options SAMEORIGIN
		-Server
	}
}
