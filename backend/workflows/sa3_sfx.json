{
  "ckpt": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": { "ckpt_name": "stable_audio_3_small_sfx.safetensors" }
  },
  "text_encoder": {
    "class_type": "CLIPLoader",
    "inputs": { "clip_name": "t5gemma_b_b_ul2.safetensors", "type": "stable_audio", "device": "default" }
  },
  "positive": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "", "clip": ["text_encoder", 0] }
  },
  "negative": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "", "clip": ["text_encoder", 0] }
  },
  "latent": {
    "class_type": "EmptyLatentAudio",
    "inputs": { "seconds": 10.0, "batch_size": 1 }
  },
  "sampler": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["ckpt", 0],
      "seed": 0,
      "steps": 8,
      "cfg": 1.0,
      "sampler_name": "lcm",
      "scheduler": "simple",
      "positive": ["positive", 0],
      "negative": ["negative", 0],
      "latent_image": ["latent", 0],
      "denoise": 1.0
    }
  },
  "decode": {
    "class_type": "VAEDecodeAudioTiled",
    "inputs": { "samples": ["sampler", 0], "vae": ["ckpt", 2], "tile_size": 32, "overlap": 8 }
  },
  "save": {
    "class_type": "SaveAudio",
    "inputs": { "audio": ["decode", 0], "filename_prefix": "happica/sfx" }
  }
}
