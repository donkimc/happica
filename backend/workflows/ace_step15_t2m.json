      "duration": 60.0,
      "timesignature": "4",
      "language": "en",
      "keyscale": "C major",
      "generate_audio_codes": true,
      "cfg_scale": 2.0,
      "temperature": 0.85,
      "top_p": 0.9,
      "top_k": 0,
      "min_p": 0.0
    }
  },
  "negative": {
    "class_type": "ConditioningZeroOut",
    "inputs": {
      "conditioning": [
        "positive",
        0
      ]
    }
  },
  "latent": {
    "class_type": "EmptyAceStep1.5LatentAudio",
    "inputs": {
